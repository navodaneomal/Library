# =====================================================================
# Library Management System — environment configuration
# Copy to `.env` (local) or set these in your hosting environment.
# Never commit real secrets.
# =====================================================================

# --- Core ------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
# Never enable DEBUG on a public server.
DEBUG=False
# Hostnames this site is served on (comma separated).
ALLOWED_HOSTS=library.example.org
# Full origin(s) for CSRF protection when served over HTTPS.
CSRF_TRUSTED_ORIGINS=https://library.example.org
# Public URL used in email links.
SITE_URL=https://library.example.org
TIME_ZONE=Asia/Colombo

# --- Docker Compose only ---------------------------------------------
# Public domain name; Caddy fetches the HTTPS certificate automatically.
DOMAIN=library.example.org
# Password for the bundled PostgreSQL container (docker-compose sets
# DATABASE_URL for you from this value).
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# --- Database --------------------------------------------------------
# PostgreSQL (recommended for production):
DATABASE_URL=postgres://library:library-password@db:5432/library
# SQLite (fine for development or very small libraries):
# DATABASE_URL=sqlite:////absolute/path/to/library.sqlite3

# --- HTTPS / proxy ---------------------------------------------------
# Set when running behind Caddy/nginx that terminates HTTPS.
BEHIND_PROXY=True
SECURE_SSL_REDIRECT=False
# Enable HSTS once HTTPS is confirmed working (e.g. 31536000).
SECURE_HSTS_SECONDS=0
# Cookies are HTTPS-only by default when DEBUG=False.
# COOKIE_SECURE=True

# --- First-run setup -------------------------------------------------
# Optional: require this token on the /setup page so nobody else can
# claim a freshly deployed installation.
SETUP_TOKEN=

# --- Email (any SMTP provider) ----------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=City Library <no-reply@library.example.org>
# For local testing print emails to the console instead:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Files -----------------------------------------------------------
# MEDIA_ROOT=/app/media
# Let Django serve uploaded covers (simple installs). Set False when the
# reverse proxy serves /media itself.
SERVE_MEDIA=True
# BACKUP_DIR=/app/backups

# --- Features --------------------------------------------------------
# Fill in book details from Open Library when an ISBN is scanned.
ISBN_LOOKUP_ENABLED=True
LOG_LEVEL=INFO
