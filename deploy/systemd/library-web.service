# /etc/systemd/system/library-web.service
[Unit]
Description=Library Management System (gunicorn)
After=network.target postgresql.service

[Service]
User=library
Group=library
WorkingDirectory=/opt/library
EnvironmentFile=/opt/library/.env
ExecStartPre=/opt/library/.venv/bin/python manage.py migrate --noinput
ExecStart=/opt/library/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 60
Restart=always
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
